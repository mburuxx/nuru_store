# Copy to .env and fill values

# Django
SECRET_KEY=replace-me-with-a-secure-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# Database (either set DATABASE_URL or these individual values)
# Example DATABASE_URL: postgres://user:password@db:5432/nuru
DATABASE_URL=postgres://nuru:strongpassword@db:5432/nuru
DB_NAME=nuru
DB_USER=nuru
DB_PASSWORD=strongpassword
DB_HOST=db
DB_PORT=5432

# Postgres settings used by docker-compose.prod.yml
POSTGRES_DB=nuru
POSTGRES_USER=nuru
POSTGRES_PASSWORD=strongpassword

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info
